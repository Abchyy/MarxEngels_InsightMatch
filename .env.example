APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
# Runtime copy only. Canonical seed is corpora/marx_engels_collected_works_cn/sqlite/corpus.db
# and is Git-ignored. Create the runtime copy with `make init-local-corpus`.
SQLITE_DATABASE_PATH=runtime-data/sqlite/corpus.db
SQLITE_BUSY_TIMEOUT_MS=5000
LANCEDB_URI=runtime-data/lancedb/current
PDF_ASSET_ROOT=runtime-data/assets/pdf
CORPUS_DATA_ROOT=runtime-data/corpus
MINERU_API_TOKEN=
# Leave empty to bind the data_version written by `make init-local-corpus`.
# Do not point this at the Canonical seed.
ACTIVE_DATA_VERSION=
ACTIVE_INDEX_VERSION=
EMBEDDING_PROVIDER=not_configured
EMBEDDING_MODEL=not_configured
EMBEDDING_DIMENSION=1024
QUERY_LOG_POLICY=hash
